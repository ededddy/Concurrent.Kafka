<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="*" />
    <PackageReference Include="Google.Protobuf" Version="*" />
		<PackageReference Include="Google.Protobuf.Tools" Version="*" />
    <PackageReference Include="Grpc.Tools" Version="*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Concurrent.Kafka.Core\Concurrent.Kafka.Core.csproj" />
    <ProjectReference Include="..\..\src\Concurrent.Kafka.DependencyInjection\Concurrent.Kafka.DependencyInjection.csproj" />
  </ItemGroup>

    <ItemGroup>
    <Protbuf Include=".\Proto\kafkaflow.proto" />
    <Content Include=".\Proto\**\*.proto">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Pack>True</Pack>
      <PackagePath>content\Protos;contentFiles\any\net6.0\Protos;contentFiles\any\netstandard2.0</PackagePath>
    </Content>
  </ItemGroup>

    <ItemGroup>
      <Folder Include="Proto/" />
    </ItemGroup>

</Project>
